# TruTerra Lead Analyzer - Environment Variables
# Add in Vercel dashboard: Project -> Settings -> Environment Variables

LAND_PORTAL_JWT=your_land_portal_jwt_here
GHL_API_KEY=your_ghl_private_integration_token_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Land Analysis Engine (api/land-analysis.js, report.js, track.js) ──
# Shared secret guarding the engine webhook. Generate with: openssl rand -hex 24
LAND_ANALYSIS_SECRET=your_long_random_secret_here

# Optional. Base URL for the branded report links (/r/:contactId) and og:image.
# Defaults to https://landportal-coral.vercel.app if unset.
# REPORT_BASE_URL=https://reports.truterra-group.com

# Optional. Full ArcGIS REST layer URL for the free TN statewide parcel layer.
# The engine reads the layer's own field metadata, so only the URL is needed.
# Defaults to the TNMap CADASTRAL parcels layer if unset.
# TN_PARCEL_LAYER_URL=https://tnmap.tn.gov/arcgis/rest/services/CADASTRAL/PARCELS/MapServer/0
